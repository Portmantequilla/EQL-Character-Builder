{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EQL Character Builder",
  "version": "0.2.0",
  "identifier": "com.eql.builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "EQL Character Builder", "width": 1280, "height": 820, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/wiki.db"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    },
    "publisher": "Bee Canyon Retro",
    "copyright": "© 2026 Bee Canyon Retro. All rights reserved.",
    "shortDescription": "Character planner for EverQuest Legends",
    "longDescription": "Plan a triple-class EverQuest Legends character: gear, upgrade tiers, buffs, spellbook, pets, and where to farm. Unaffiliated fan software; data mirrored from eqlwiki.com.",
    "licenseFile": "../../LICENSE.txt"
  }
}
